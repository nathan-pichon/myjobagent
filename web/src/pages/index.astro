  #wizard-columns.wide {
    grid-template-columns: 1fr minmax(280px, 340px);
  }
}

/* Ensure sidebar JSON is monospace */
#sidebar-json, #json-preview {
  font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
}

