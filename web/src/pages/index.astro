// Current language (global so copyText can access)
let _currentLang: 'en' | 'fr' = 'en';

function applyLang(lang: 'en' | 'fr') {
  _currentLang = lang;
  const dict = I18N[lang];

  // Update html lang attribute
  document.documentElement.lang = lang;

  // Update textContent for data-i18n elements
  document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n!;
    if (dict[key] !== undefined) {
      // Preserve inner HTML for elements that contain child nodes (e.g. <code>)
      // Only update textContent for simple text nodes
      if (el.children.length === 0) {
        el.textContent = dict[key];
      }
      // For elements with children, skip — they have their own child data-i18n keys
    }
  });

  // Update placeholders
  document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach(el => {
    const key = el.dataset.i18nPlaceholder!;
    if (dict[key] !== undefined) el.placeholder = dict[key];
  });

  // Update aria-labels
  document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach(el => {
    const key = el.dataset.i18nAria!;
    if (dict[key] !== undefined) el.setAttribute('aria-label', dict[key]);
  });

  // Update titles
  document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach(el => {
    const key = el.dataset.i18nTitle!;
    if (dict[key] !== undefined) el.setAttribute('title', dict[key]);
  });

  // Update wizard nav aria-label
  const wizNav = document.getElementById('wizard-nav-aria');
  if (wizNav) wizNav.setAttribute('aria-label', lang === 'fr' ? 'Étapes du configurateur' : 'Configurator steps');

  // Update language switcher button states
  const btnEn = document.getElementById('lang-en');
  const btnFr = document.getElementById('lang-fr');
  if (btnEn && btnFr) {
    if (lang === 'en') {
      btnEn.style.background = 'var(--jb-primary)';
      btnEn.style.color = 'white';
      btnFr.style.background = 'transparent';
      btnFr.style.color = 'var(--jb-text-muted)';
      btnEn.setAttribute('aria-pressed', 'true');
      btnFr.setAttribute('aria-pressed', 'false');
    } else {
      btnFr.style.background = 'var(--jb-primary)';
      btnFr.style.color = 'white';
      btnEn.style.background = 'transparent';
      btnEn.style.color = 'var(--jb-text-muted)';
      btnFr.setAttribute('aria-pressed', 'true');
      btnEn.setAttribute('aria-pressed', 'false');
    }
  }

  // Persist choice
  try { localStorage.setItem('mja_lang', lang); } catch(e) {}
}

// Expose globally for inline onclick handlers
(window as any).__setLang = applyLang;

