// ---- RESTORE from localStorage ----
function saveState() {
  try { localStorage.setItem('jb_wizard_state', JSON.stringify(state)); } catch(e) {}
}

function restoreState() {
  try {
    const saved = localStorage.getItem('jb_wizard_state');
    if (!saved) return;
    const parsed = JSON.parse(saved);
    Object.assign(state.profile, parsed.profile || {});
    Object.assign(state.search, parsed.search || {});
    Object.assign(state.llm, parsed.llm || {});
    Object.assign(state.sources, parsed.sources || {});
    Object.assign(state.scoring, parsed.scoring || {});
  } catch(e) {}
}

// ---- TAG INPUT HELPER ----
function initTagInput(inputId: string, addBtnId: string, tagsId: string, stateArray: string[], stateKey: string) {
  const input = document.getElementById(inputId) as HTMLInputElement;
  const addBtn = document.getElementById(addBtnId);
  const container = document.getElementById(tagsId);

  if (!input || !addBtn || !container) return;

  function renderTags() {
    container.innerHTML = '';
    stateArray.forEach((tag, i) => {
      const span = document.createElement('span');
      span.className = 'jb-tag';
      const dict = I18N[_currentLang];
      span.innerHTML = `${tag}<button class="jb-tag-remove" aria-label="${dict['btn.remove'] || 'Remove'} ${tag}" data-idx="${i}">&times;</button>`;
      container.appendChild(span);
    });
    updateJSON();
    saveState();
  }

  function addTag() {
    const val = input.value.trim();
    if (val && !stateArray.includes(val)) {
      stateArray.push(val);
      renderTags();
    }
    input.value = '';
    input.focus();
  }

  addBtn.addEventListener('click', addTag);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); addTag(); }
  });

  container.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.jb-tag-remove');
    if (btn) {
      const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
      stateArray.splice(idx, 1);
      renderTags();
    }
  });

  // Render initial tags from state (restored from localStorage)
  renderTags();
}

// ---- BUILD CONFIG JSON ----
function buildConfig() {
  const cfg: Record<string, any> = {
    schema_version: '1.0',
    profile: { ...state.profile },
    llm: { ...state.llm },
    search: { ...state.search },
    sources: { ...state.sources },
    scoring: { ...state.scoring },
    filters: {
      domain_blacklist: [],
      reject_url_patterns: [],
      fasttrack_job_patterns: [],
    },
  };
  // Remove null optional fields from profile
  if (!cfg.profile.years_experience) delete cfg.profile.years_experience;
  if (!cfg.profile.min_salary) delete cfg.profile.min_salary;
  if (!cfg.profile.min_tjm) delete cfg.profile.min_tjm;
  return cfg;
}

// ---- UPDATE JSON DISPLAY ----
function updateJSON() {
  const cfg = buildConfig();
  const pretty = JSON.stringify(cfg, null, 2);

  const sidebar = document.getElementById('sidebar-json');
  if (sidebar) sidebar.textContent = pretty;

  const preview = document.getElementById('json-preview');
  if (preview) preview.textContent = pretty;

  // Update base64url command
  const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(cfg))))
    .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const b64Display = document.getElementById('b64-cmd-display');
  if (b64Display) b64Display.textContent = `mja init --b64 ${b64}`;

  const copyB64 = document.getElementById('copy-b64-cmd');
  if (copyB64) {
    (copyB64 as HTMLElement & { _b64: string })._b64 = `mja init --b64 ${b64}`;
  }
}

// ---- STEP NAVIGATION ----
function goToStep(targetStep: number) {
  // Hide all steps
  document.querySelectorAll<HTMLElement>('.wizard-step').forEach(s => {
    s.style.display = 'none';
  });
  // Show target step
  const target = document.querySelector<HTMLElement>(`.wizard-step[data-step="${targetStep}"]`);
  if (target) target.style.display = '';

  // Update step buttons
  document.querySelectorAll<HTMLElement>('.step-btn').forEach(btn => {
    const s = parseInt(btn.dataset.step || '0', 10);
    const numEl = btn.querySelector('.step-num') as HTMLElement;
    btn.removeAttribute('aria-current');
    if (s === targetStep) {
      btn.style.borderColor = 'var(--jb-primary)';
      btn.style.background = 'var(--jb-primary-soft)';
      btn.style.color = 'var(--jb-primary)';
      if (numEl) { numEl.style.background = 'var(--jb-primary)'; numEl.style.color = 'white'; }
      btn.setAttribute('aria-current', 'step');
    } else if (s < targetStep) {
      btn.style.borderColor = 'var(--jb-accent)';
      btn.style.background = 'var(--jb-accent-bg)';
      btn.style.color = 'var(--jb-accent-text)';
      if (numEl) { numEl.style.background = 'var(--jb-accent-text)'; numEl.style.color = 'white'; }
    } else {
      btn.style.borderColor = 'var(--jb-border)';
      btn.style.background = 'var(--jb-surface)';
      btn.style.color = 'var(--jb-text-muted)';
      if (numEl) { numEl.style.background = 'var(--jb-border)'; numEl.style.color = 'var(--jb-text-muted)'; }
    }
  });

  state.step = targetStep;

  // Show sidebar JSON only from step 2+
  const sidebar = document.getElementById('json-sidebar');
  if (sidebar) sidebar.style.display = targetStep >= 1 ? '' : 'none';

  // Update columns layout on wide screens
  updateColumnsLayout();
  updateJSON();

  // Scroll wizard into view smoothly
  document.getElementById('wizard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function updateColumnsLayout() {
  const cols = document.getElementById('wizard-columns');
  if (!cols) return;
  if (window.innerWidth >= 900 && state.step >= 1) {
    cols.style.gridTemplateColumns = '1fr minmax(280px, 340px)';
  } else {
    cols.style.gridTemplateColumns = '1fr';
  }
}

// ---- OS DETECTION ----
function detectOS() {
  const p = navigator.platform?.toLowerCase() || '';
  const ua = navigator.userAgent?.toLowerCase() || '';
  if (p.includes('win') || ua.includes('windows')) return 'windows';
  if (p.includes('linux') || ua.includes('linux')) return 'linux';
  return 'mac'; // default macOS
}

function activateOsTab(os: string) {
  document.querySelectorAll<HTMLElement>('.os-tab').forEach(t => {
    if (t.dataset.os === os) {
      t.style.borderBottomColor = 'var(--jb-primary)';
      t.style.color = 'var(--jb-primary)';
      t.style.fontWeight = '600';
    } else {
      t.style.borderBottomColor = 'transparent';
      t.style.color = 'var(--jb-text-muted)';
      t.style.fontWeight = '';
    }
  });
  document.querySelectorAll<HTMLElement>('.os-panel').forEach(p => {
    p.style.display = p.id === `os-${os}` ? '' : 'none';
  });
}

// ---- COPY HELPER ----
async function copyText(text: string, btn: HTMLElement) {
  const dict = I18N[_currentLang];
  const copiedLabel = dict['copied'] || 'Copied!';
  try {
    await navigator.clipboard.writeText(text);
    const orig = btn.textContent;
    btn.textContent = copiedLabel;
    btn.style.color = 'var(--jb-accent-text)';
    setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 1800);
  } catch(e) {
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    const orig = btn.textContent;
    btn.textContent = copiedLabel;
    setTimeout(() => { btn.textContent = orig; }, 1800);
  }
}

// ---- DOWNLOAD ----
function downloadConfig() {
  const cfg = buildConfig();
  const json = JSON.stringify(cfg, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'jobhunt.config.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// ---- LLM DEFAULTS ----
const LLM_DEFAULTS: Record<string, { model: string; base_url: string }> = {
  ollama:    { model: 'gemma4:e2b',             base_url: 'http://localhost:11434' },
  lmstudio:  { model: 'local-model',             base_url: 'http://localhost:1234' },
  openai:    { model: 'gpt-4o-mini',             base_url: 'https://api.openai.com/v1' },
  anthropic: { model: 'claude-haiku-4-5',       base_url: 'https://api.anthropic.com' },
  mistral:   { model: 'mistral-small-latest',    base_url: 'https://api.mistral.ai/v1' },
  groq:      { model: 'llama-3.1-8b-instant',   base_url: 'https://api.groq.com/openai/v1' },
};

const MODEL_HINTS: Record<string, Record<string, string>> = {
  ollama:    { en: 'For Ollama: gemma4:e2b (lightweight), gemma4:e4b, qwen2.5:7b', fr: 'Pour Ollama : gemma4:e2b (léger), gemma4:e4b, qwen2.5:7b' },
  lmstudio:  { en: 'Enter the name of the model loaded in LM Studio', fr: 'Entrez le nom du modèle chargé dans LM Studio' },
  openai:    { en: 'E.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo', fr: 'Ex : gpt-4o-mini, gpt-4o, gpt-3.5-turbo' },
  anthropic: { en: 'E.g. claude-haiku-4-5, claude-sonnet-4-5', fr: 'Ex : claude-haiku-4-5, claude-sonnet-4-5' },
  mistral:   { en: 'E.g. mistral-small-latest, mistral-medium-latest', fr: 'Ex : mistral-small-latest, mistral-medium-latest' },
  groq:      { en: 'E.g. llama-3.1-8b-instant, mixtral-8x7b-32768', fr: 'Ex : llama-3.1-8b-instant, mixtral-8x7b-32768' },
};

// ============================================================
//  INIT
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  // ---- Language detection & apply ----
  let initLang: 'en' | 'fr' = 'en';
  try {
    const stored = localStorage.getItem('mja_lang');
    if (stored === 'en' || stored === 'fr') {
      initLang = stored;
    } else {
      initLang = navigator.language?.startsWith('fr') ? 'fr' : 'en';
    }
  } catch(e) {
    initLang = navigator.language?.startsWith('fr') ? 'fr' : 'en';
  }
  applyLang(initLang);

  // Restore from localStorage
  restoreState();

  // Initialize tag inputs
  initTagInput('roles-input', 'roles-add', 'roles-tags', state.profile.roles, 'roles');
  initTagInput('stack-core-input', 'stack-core-add', 'stack-core-tags', state.profile.stack_core, 'stack_core');
  initTagInput('stack-nice-input', 'stack-nice-add', 'stack-nice-tags', state.profile.stack_nice, 'stack_nice');
  initTagInput('exclusions-input', 'exclusions-add', 'exclusions-tags', state.profile.exclusions, 'exclusions');
  initTagInput('geography-input', 'geography-add', 'geography-tags', state.profile.geography, 'geography');
  initTagInput('platforms-input', 'platforms-add', 'platforms-tags', state.search.platforms, 'platforms');

  // Restore form fields from state
  const seniorityEl = document.getElementById('seniority-select') as HTMLSelectElement;
  if (seniorityEl) { seniorityEl.value = state.profile.seniority; }

  const yearsEl = document.getElementById('years-exp') as HTMLInputElement;
  if (yearsEl && state.profile.years_experience) yearsEl.value = String(state.profile.years_experience);

  const salaryEl = document.getElementById('min-salary') as HTMLInputElement;
  if (salaryEl && state.profile.min_salary) salaryEl.value = String(state.profile.min_salary);

  const tjmEl = document.getElementById('min-tjm') as HTMLInputElement;
  if (tjmEl && state.profile.min_tjm) tjmEl.value = String(state.profile.min_tjm);

  // Contract checkboxes
  document.querySelectorAll<HTMLInputElement>('.contract-cb').forEach(cb => {
    cb.checked = state.profile.contract_types.includes(cb.dataset.contract || '');
    cb.addEventListener('change', () => {
      const contract = cb.dataset.contract || '';
      if (cb.checked && !state.profile.contract_types.includes(contract)) {
        state.profile.contract_types.push(contract);
      } else if (!cb.checked) {
        state.profile.contract_types = state.profile.contract_types.filter(c => c !== contract);
      }
      updateJSON(); saveState();
    });
  });

  // Seniority
  if (seniorityEl) {
    seniorityEl.addEventListener('change', () => { state.profile.seniority = seniorityEl.value; updateJSON(); saveState(); });
  }

  // Years
  if (yearsEl) {
    yearsEl.addEventListener('input', () => { state.profile.years_experience = parseInt(yearsEl.value) || null; updateJSON(); saveState(); });
  }

  // Salary
  if (salaryEl) {
    salaryEl.addEventListener('input', () => { state.profile.min_salary = parseInt(salaryEl.value) || null; updateJSON(); saveState(); });
  }

  // TJM
  if (tjmEl) {
    tjmEl.addEventListener('input', () => { state.profile.min_tjm = parseInt(tjmEl.value) || null; updateJSON(); saveState(); });
  }

  // Search modes
  document.querySelectorAll<HTMLInputElement>('.mode-cb').forEach(cb => {
    const mode = cb.dataset.mode as 'PLATFORM' | 'CAREERS' | 'LINKEDIN';
    cb.checked = state.search.modes.includes(mode);
    cb.addEventListener('change', () => {
      if (cb.checked && !state.search.modes.includes(mode)) {
        state.search.modes.push(mode);
      } else if (!cb.checked) {
        state.search.modes = state.search.modes.filter(m => m !== mode);
      }
      updateJSON(); saveState();
    });
  });

  // Score threshold
  const slider = document.getElementById('score-threshold') as HTMLInputElement;
  const display = document.getElementById('threshold-display');
  if (slider) {
    slider.value = String(state.scoring.threshold);
    if (display) display.textContent = String(state.scoring.threshold);
    slider.addEventListener('input', () => {
      state.scoring.threshold = parseInt(slider.value, 10);
      if (display) display.textContent = slider.value;
      updateJSON(); saveState();
    });
  }

  // LLM provider radio cards
  document.querySelectorAll<HTMLInputElement>('.llm-provider-radio').forEach(radio => {
    radio.checked = radio.value === state.llm.provider;
    radio.addEventListener('change', () => {
      if (!radio.checked) return;
      const provider = radio.value as keyof typeof LLM_DEFAULTS;
      state.llm.provider = provider;
      const defaults = LLM_DEFAULTS[provider];
      if (defaults) {
        state.llm.model = defaults.model;
        state.llm.base_url = defaults.base_url;
        const modelEl = document.getElementById('llm-model') as HTMLInputElement;
        const urlEl = document.getElementById('llm-base-url') as HTMLInputElement;
        const hintEl = document.getElementById('llm-model-hint');
        if (modelEl) modelEl.value = defaults.model;
        if (urlEl) urlEl.value = defaults.base_url;
        if (hintEl) hintEl.textContent = (MODEL_HINTS[provider] && MODEL_HINTS[provider][_currentLang]) || '';
      }
      // Update card styles
      document.querySelectorAll<HTMLElement>('.llm-card').forEach(card => {
        if (card.dataset.provider === provider) {
          card.style.borderColor = 'var(--jb-primary)';
          card.style.background = 'var(--jb-primary-soft)';
        } else {
          card.style.borderColor = 'var(--jb-border)';
          card.style.background = 'var(--jb-surface)';
        }
      });
      updateJSON(); saveState();
    });
  });

  // LLM model input
  const modelInput = document.getElementById('llm-model') as HTMLInputElement;
  if (modelInput) {
    modelInput.value = state.llm.model;
    modelInput.addEventListener('input', () => { state.llm.model = modelInput.value; updateJSON(); saveState(); });
  }

  const urlInput = document.getElementById('llm-base-url') as HTMLInputElement;
  if (urlInput) {
    urlInput.value = state.llm.base_url;
    urlInput.addEventListener('input', () => { state.llm.base_url = urlInput.value; updateJSON(); saveState(); });
  }

  // Sources toggles
  const srcFT = document.getElementById('src-france-travail') as HTMLInputElement;
  const srcRss = document.getElementById('src-rss') as HTMLInputElement;
  const srcWTTJ = document.getElementById('src-wttj') as HTMLInputElement;
  const srcIndeed = document.getElementById('src-indeed') as HTMLInputElement;
  const srcLinkedIn = document.getElementById('src-linkedin') as HTMLInputElement;

  if (srcRss) { srcRss.checked = state.sources.rss_enabled; srcRss.addEventListener('change', () => { state.sources.rss_enabled = srcRss.checked; updateJSON(); saveState(); }); }
  if (srcFT) { srcFT.checked = state.sources.france_travail_enabled; srcFT.addEventListener('change', () => { state.sources.france_travail_enabled = srcFT.checked; updateJSON(); saveState(); }); }
  if (srcWTTJ) { srcWTTJ.checked = state.sources.welcometothejungle_enabled; srcWTTJ.addEventListener('change', () => { state.sources.welcometothejungle_enabled = srcWTTJ.checked; updateJSON(); saveState(); }); }
  if (srcIndeed) { srcIndeed.checked = state.sources.indeed_enabled; srcIndeed.addEventListener('change', () => { state.sources.indeed_enabled = srcIndeed.checked; updateJSON(); saveState(); }); }
  if (srcLinkedIn) { srcLinkedIn.checked = state.sources.linkedin_enabled; srcLinkedIn.addEventListener('change', () => { state.sources.linkedin_enabled = srcLinkedIn.checked; updateJSON(); saveState(); }); }

  // Step navigation buttons
  document.querySelectorAll<HTMLButtonElement>('.step-btn').forEach(btn => {
    btn.addEventListener('click', () => goToStep(parseInt(btn.dataset.step || '0', 10)));
  });

  document.querySelectorAll<HTMLButtonElement>('.next-step').forEach(btn => {
    btn.addEventListener('click', () => goToStep(parseInt(btn.dataset.next || '0', 10)));
  });

  document.querySelectorAll<HTMLButtonElement>('.prev-step').forEach(btn => {
    btn.addEventListener('click', () => goToStep(parseInt(btn.dataset.prev || '0', 10)));
  });

  // Suggestion buttons
  const tagTargets: Record<string, string[]> = {
    'roles': state.profile.roles,
    'stack-core': state.profile.stack_core,
    'geography': state.profile.geography,
    'platforms': state.search.platforms,
  };

  const tagContainers: Record<string, string> = {
    'roles': 'roles-tags',
    'stack-core': 'stack-core-tags',
    'geography': 'geography-tags',
    'platforms': 'platforms-tags',
  };

  document.querySelectorAll<HTMLButtonElement>('.suggestion-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target || '';
      const value = btn.dataset.value || '';
      const arr = tagTargets[target];
      const containerId = tagContainers[target];
      if (arr && value && !arr.includes(value)) {
        arr.push(value);
        // Re-render tags for this container
        const container = document.getElementById(containerId);
        if (container) {
          container.innerHTML = '';
          const dict = I18N[_currentLang];
          arr.forEach((tag, i) => {
            const span = document.createElement('span');
            span.className = 'jb-tag';
            span.innerHTML = `${tag}<button class="jb-tag-remove" aria-label="${dict['btn.remove'] || 'Remove'} ${tag}" data-idx="${i}">&times;</button>`;
            container.appendChild(span);
          });
          container.addEventListener('click', (e) => {
            const removeBtn = (e.target as HTMLElement).closest('.jb-tag-remove');
            if (removeBtn) {
              const idx = parseInt((removeBtn as HTMLElement).dataset.idx || '0', 10);
              arr.splice(idx, 1);
              const ev = new Event('_rerender');
              container.dispatchEvent(ev);
            }
          });
        }
        updateJSON(); saveState();
      }
    });
  });

  // Download button
  document.getElementById('download-config')?.addEventListener('click', downloadConfig);

  // Copy JSON button (preview area)
  document.getElementById('copy-json-btn')?.addEventListener('click', (e) => {
    copyText(JSON.stringify(buildConfig(), null, 2), e.currentTarget as HTMLElement);
  });

  // Sidebar copy
  document.getElementById('sidebar-copy-json')?.addEventListener('click', (e) => {
    copyText(JSON.stringify(buildConfig(), null, 2), e.currentTarget as HTMLElement);
  });

  // Copy command buttons
  document.querySelectorAll<HTMLElement>('.copy-cmd').forEach(btn => {
    btn.addEventListener('click', () => copyText(btn.dataset.cmd || '', btn));
  });

  // Copy base64 command
  document.getElementById('copy-b64-cmd')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement & { _b64: string };
    copyText(btn._b64 || document.getElementById('b64-cmd-display')?.textContent || '', btn);
  });

  // Show JSON toggle (privacy disclosure)
  document.getElementById('show-json-toggle')?.addEventListener('click', (e) => {
    const wrapper = document.getElementById('json-preview-wrapper');
    if (!wrapper) return;
    const isHidden = wrapper.style.display === 'none';
    wrapper.style.display = isHidden ? '' : 'none';
    const btn = e.currentTarget as HTMLElement;
    const dict = I18N[_currentLang];
    btn.textContent = isHidden ? (dict['generate.hide.json'] || 'Hide JSON') : (dict['generate.show.json'] || 'View what it contains');
    updateJSON();
  });

  // OS tabs
  document.querySelectorAll<HTMLElement>('.os-tab').forEach(tab => {
    tab.addEventListener('click', () => activateOsTab(tab.dataset.os || 'mac'));
  });

  // Responsive: adjust layout on resize
  window.addEventListener('resize', updateColumnsLayout);

  // Detect OS and set active tab
  const detectedOS = detectOS();
  activateOsTab(detectedOS);

  // Initial render
  updateColumnsLayout();
  updateJSON();
  goToStep(state.step);
});
</script>

