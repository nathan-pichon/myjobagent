---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ===================== HEADER ===================== -->
  <header style="background:var(--jb-surface);border-bottom:1px solid var(--jb-border);position:sticky;top:0;z-index:50;">
    <div style="max-width:1100px;margin:0 auto;padding:0 1.25rem;display:flex;align-items:center;justify-content:space-between;height:3.5rem;">
      <div style="display:flex;align-items:center;gap:0.625rem;">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="hLogo" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#2E6BFF"/>
              <stop offset="100%" stop-color="#00C2A8"/>
            </linearGradient>
          </defs>
          <circle cx="16" cy="16" r="14" fill="url(#hLogo)"/>
          <circle cx="16" cy="16" r="5" fill="white" opacity="0.9"/>
          <circle cx="16" cy="16" r="2" fill="url(#hLogo)"/>
        </svg>
        <span style="font-weight:700;font-size:1.0625rem;color:var(--jb-text);">MyJobAgent</span>
      </div>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span class="privacy-badge" data-i18n="header.privacy">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          100% local — nothing is sent
        </span>

        <!-- Language switcher -->
        <div id="lang-switcher" role="group" aria-label="Language / Langue" style="display:flex;gap:2px;border:1px solid var(--jb-border);border-radius:999px;padding:2px;background:var(--jb-surface-alt);">
          <button id="lang-en" type="button" aria-label="Switch to English" aria-pressed="true"
            onclick="window.__setLang('en')"
            style="padding:0.2rem 0.6rem;border:none;border-radius:999px;font-size:0.75rem;font-weight:600;cursor:pointer;background:var(--jb-primary);color:white;transition:background 0.15s,color 0.15s;">
            EN
          </button>
          <button id="lang-fr" type="button" aria-label="Passer en français" aria-pressed="false"
            onclick="window.__setLang('fr')"
            style="padding:0.2rem 0.6rem;border:none;border-radius:999px;font-size:0.75rem;font-weight:600;cursor:pointer;background:transparent;color:var(--jb-text-muted);transition:background 0.15s,color 0.15s;">
            FR
          </button>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ===================== HERO ===================== -->
    <section aria-labelledby="hero-title" style="overflow:hidden;position:relative;">
      <!-- Beam background -->
      <div style="position:absolute;inset:0;background:var(--jb-beam);opacity:0.07;" aria-hidden="true"></div>
      <!-- Beam orb -->
      <div style="position:absolute;top:-4rem;right:-4rem;width:22rem;height:22rem;background:radial-gradient(circle,rgba(46,107,255,.15) 0%,transparent 70%);pointer-events:none;" aria-hidden="true"></div>

      <div style="position:relative;max-width:1100px;margin:0 auto;padding:4rem 1.25rem 3.5rem;text-align:center;">
        <p style="display:inline-block;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--jb-accent-text);background:var(--jb-accent-bg);border-radius:999px;padding:0.25rem 0.875rem;margin-bottom:1.25rem;" data-i18n="hero.badge">
          Local AI Agent · Open Source
        </p>

        <h1 id="hero-title" style="font-size:clamp(2rem,5vw,3.25rem);font-weight:700;line-height:1.15;color:var(--jb-text);max-width:680px;margin:0 auto 1.25rem;" data-i18n="hero.title">
          Describe your ideal job once.<br>
          <span style="background:var(--jb-beam);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;" data-i18n="hero.title.highlight">Your agent searches locally</span><br>
          and explains every score.
        </h1>

        <p style="font-size:1.0625rem;color:var(--jb-text-muted);max-width:520px;margin:0 auto 2rem;line-height:1.65;" data-i18n="hero.subtitle">
          MyJobAgent scans job platforms with a local LLM,
          scores each listing out of 100, and generates a private dashboard — without sending your data anywhere.
        </p>

        <div style="display:flex;flex-wrap:wrap;gap:0.875rem;justify-content:center;align-items:center;">
          <a href="#wizard" class="jb-btn-primary" style="font-size:1rem;padding:0.75rem 2rem;" data-i18n="hero.cta.create">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            Create my agent
          </a>
          <a href="https://github.com" class="jb-btn-secondary" target="_blank" rel="noopener noreferrer" data-i18n="hero.cta.github">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
            View source
          </a>
        </div>

        <!-- How it works - 3 steps -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.25rem;margin-top:3.5rem;text-align:left;">
          <div class="jb-card" style="padding:1.25rem;">
            <div style="width:2.25rem;height:2.25rem;background:var(--jb-primary-soft);border-radius:var(--jb-radius-input);display:flex;align-items:center;justify-content:center;margin-bottom:0.875rem;">
              <span style="color:var(--jb-primary);font-weight:700;font-size:0.9375rem;">1</span>
            </div>
            <h3 style="font-size:0.9375rem;font-weight:600;color:var(--jb-text);margin-bottom:0.375rem;" data-i18n="hero.step1.title">Configure your profile</h3>
            <p style="font-size:0.8125rem;color:var(--jb-text-muted);line-height:1.55;" data-i18n="hero.step1.desc">Roles, stack, location, contract, min salary — all in a guided form.</p>
          </div>
          <div class="jb-card" style="padding:1.25rem;">
            <div style="width:2.25rem;height:2.25rem;background:var(--jb-accent-bg);border-radius:var(--jb-radius-input);display:flex;align-items:center;justify-content:center;margin-bottom:0.875rem;">
              <span style="color:var(--jb-accent-text);font-weight:700;font-size:0.9375rem;">2</span>
            </div>
            <h3 style="font-size:0.9375rem;font-weight:600;color:var(--jb-text);margin-bottom:0.375rem;" data-i18n="hero.step2.title">Run the agent locally</h3>
            <p style="font-size:0.8125rem;color:var(--jb-text-muted);line-height:1.55;" data-i18n="hero.step2.desc">Download your config, run <code style="font-family:monospace;font-size:0.75rem;background:var(--jb-surface-alt);padding:0.1em 0.3em;border-radius:4px;">mja run</code>. The agent scans for you.</p>
          </div>
          <div class="jb-card" style="padding:1.25rem;">
            <div style="width:2.25rem;height:2.25rem;background:var(--jb-signal);border-radius:var(--jb-radius-input);display:flex;align-items:center;justify-content:center;margin-bottom:0.875rem;">
              <span style="color:var(--jb-signal-text);font-weight:700;font-size:0.9375rem;">3</span>
            </div>
            <h3 style="font-size:0.9375rem;font-weight:600;color:var(--jb-text);margin-bottom:0.375rem;" data-i18n="hero.step3.title">Browse the matches</h3>
            <p style="font-size:0.8125rem;color:var(--jb-text-muted);line-height:1.55;" data-i18n="hero.step3.desc">Local dashboard with detailed score — never sent anywhere.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== WIZARD ===================== -->
    <section id="wizard" aria-labelledby="wizard-title" style="max-width:1100px;margin:0 auto;padding:3rem 1.25rem 5rem;">
      <div style="text-align:center;margin-bottom:2.5rem;">
        <h2 id="wizard-title" style="font-size:1.875rem;font-weight:700;color:var(--jb-text);margin-bottom:0.625rem;" data-i18n="wizard.title">Create your configuration</h2>
        <p style="color:var(--jb-text-muted);font-size:0.9375rem;" data-i18n="wizard.subtitle">Complete the steps below. Your config is generated in your browser — nothing is sent.</p>
      </div>

      <!-- Main wizard container -->
      <div id="wizard-app" style="display:grid;grid-template-columns:1fr;gap:1.5rem;">
        <!-- Step navigation -->
        <nav aria-label="Configurator steps" id="wizard-nav-aria" style="display:flex;align-items:center;justify-content:center;gap:0.875rem;flex-wrap:wrap;">
          <button class="step-btn active" data-step="0" aria-current="step" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:var(--jb-radius-pill);border:1px solid var(--jb-primary);background:var(--jb-primary-soft);color:var(--jb-primary);font-weight:600;font-size:0.8125rem;cursor:pointer;">
            <span class="step-num" style="width:1.25rem;height:1.25rem;background:var(--jb-primary);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;">1</span>
            <span data-i18n="step.profile">Profile</span>
          </button>
          <div style="width:1.5rem;height:1px;background:var(--jb-border);flex-shrink:0;" aria-hidden="true"></div>
          <button class="step-btn" data-step="1" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:var(--jb-radius-pill);border:1px solid var(--jb-border);background:var(--jb-surface);color:var(--jb-text-muted);font-size:0.8125rem;cursor:pointer;">
            <span class="step-num" style="width:1.25rem;height:1.25rem;background:var(--jb-border);color:var(--jb-text-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;">2</span>
            <span data-i18n="step.search">Search</span>
          </button>
          <div style="width:1.5rem;height:1px;background:var(--jb-border);flex-shrink:0;" aria-hidden="true"></div>
          <button class="step-btn" data-step="2" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:var(--jb-radius-pill);border:1px solid var(--jb-border);background:var(--jb-surface);color:var(--jb-text-muted);font-size:0.8125rem;cursor:pointer;">
            <span class="step-num" style="width:1.25rem;height:1.25rem;background:var(--jb-border);color:var(--jb-text-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;">3</span>
            LLM
          </button>
          <div style="width:1.5rem;height:1px;background:var(--jb-border);flex-shrink:0;" aria-hidden="true"></div>
          <button class="step-btn" data-step="3" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:var(--jb-radius-pill);border:1px solid var(--jb-border);background:var(--jb-surface);color:var(--jb-text-muted);font-size:0.8125rem;cursor:pointer;">
            <span class="step-num" style="width:1.25rem;height:1.25rem;background:var(--jb-border);color:var(--jb-text-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;">4</span>
            <span data-i18n="step.sources">Sources</span>
          </button>
          <div style="width:1.5rem;height:1px;background:var(--jb-border);flex-shrink:0;" aria-hidden="true"></div>
          <button class="step-btn" data-step="4" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:var(--jb-radius-pill);border:1px solid var(--jb-border);background:var(--jb-surface);color:var(--jb-text-muted);font-size:0.8125rem;cursor:pointer;">
            <span class="step-num" style="width:1.25rem;height:1.25rem;background:var(--jb-border);color:var(--jb-text-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;">5</span>
            <span data-i18n="step.generate">Generate</span>
          </button>
        </nav>

        <!-- Two-column layout on desktop: form + preview -->
        <div id="wizard-columns" style="display:grid;grid-template-columns:1fr;gap:1.5rem;">

          <!-- Form area -->
          <div id="wizard-form" class="jb-card" style="padding:1.75rem;">

            <!-- === STEP 1: Profile === -->
            <div class="wizard-step" data-step="0">
              <h3 style="font-size:1.125rem;font-weight:700;color:var(--jb-text);margin-bottom:1.5rem;" data-i18n="profile.heading">Your search profile</h3>

              <div style="display:grid;gap:1.25rem;">

                <!-- Roles -->
                <div>
                  <label class="jb-label" for="roles-input"><span data-i18n="profile.roles.label">Target roles</span> <span style="color:var(--jb-danger)">*</span></label>
                  <div id="roles-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="roles-input" type="text" data-i18n-placeholder="profile.roles.placeholder" placeholder="E.g. Senior Backend Engineer — Enter to add" aria-describedby="roles-hint" style="flex:1;" />
                    <button type="button" id="roles-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                  <p id="roles-hint" style="font-size:0.75rem;color:var(--jb-text-muted);margin-top:0.375rem;" data-i18n="profile.roles.hint">Suggestions: Senior Backend Engineer · Tech Lead · Backend Architect · Fractional CTO</p>
                  <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-top:0.5rem;" aria-hidden="true">
                    <button type="button" class="suggestion-btn" data-target="roles" data-value="Senior Backend Engineer" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Senior Backend Engineer</button>
                    <button type="button" class="suggestion-btn" data-target="roles" data-value="Tech Lead Backend" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Tech Lead Backend</button>
                    <button type="button" class="suggestion-btn" data-target="roles" data-value="Backend Architect" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Backend Architect</button>
                    <button type="button" class="suggestion-btn" data-target="roles" data-value="Fractional CTO" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Fractional CTO</button>
                    <button type="button" class="suggestion-btn" data-target="roles" data-value="Principal Engineer" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Principal Engineer</button>
                  </div>
                </div>

                <!-- Stack core -->
                <div>
                  <label class="jb-label" for="stack-core-input" data-i18n="profile.stackcore.label">Core stack (must-have)</label>
                  <div id="stack-core-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="stack-core-input" type="text" data-i18n-placeholder="profile.stackcore.placeholder" placeholder="E.g. Node.js, TypeScript…" style="flex:1;" />
                    <button type="button" id="stack-core-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-top:0.5rem;" aria-hidden="true">
                    <button type="button" class="suggestion-btn" data-target="stack-core" data-value="Node.js" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Node.js</button>
                    <button type="button" class="suggestion-btn" data-target="stack-core" data-value="TypeScript" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">TypeScript</button>
                    <button type="button" class="suggestion-btn" data-target="stack-core" data-value="Python" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Python</button>
                    <button type="button" class="suggestion-btn" data-target="stack-core" data-value="Go" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Go</button>
                    <button type="button" class="suggestion-btn" data-target="stack-core" data-value="Rust" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Rust</button>
                  </div>
                </div>

                <!-- Stack nice -->
                <div>
                  <label class="jb-label" for="stack-nice-input" data-i18n="profile.stacknice.label">Nice-to-have stack (bonus)</label>
                  <div id="stack-nice-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="stack-nice-input" type="text" data-i18n-placeholder="profile.stacknice.placeholder" placeholder="E.g. Docker, Kubernetes, MongoDB…" style="flex:1;" />
                    <button type="button" id="stack-nice-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                </div>

                <!-- Exclusions -->
                <div>
                  <label class="jb-label" for="exclusions-input" data-i18n="profile.exclusions.label">Exclusions (hard stop)</label>
                  <div id="exclusions-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="exclusions-input" type="text" data-i18n-placeholder="profile.exclusions.placeholder" placeholder="E.g. PHP, on-site only…" style="flex:1;" />
                    <button type="button" id="exclusions-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                </div>

                <!-- Geography -->
                <div>
                  <label class="jb-label" for="geography-input" data-i18n="profile.geography.label">Location / Geography</label>
                  <div id="geography-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="geography-input" type="text" data-i18n-placeholder="profile.geography.placeholder" placeholder="E.g. Nice, Remote, Bordeaux…" style="flex:1;" />
                    <button type="button" id="geography-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-top:0.5rem;" aria-hidden="true">
                    <button type="button" class="suggestion-btn" data-target="geography" data-value="Remote" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Remote</button>
                    <button type="button" class="suggestion-btn" data-target="geography" data-value="Full Remote" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Full Remote</button>
                    <button type="button" class="suggestion-btn" data-target="geography" data-value="Paris" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Paris</button>
                    <button type="button" class="suggestion-btn" data-target="geography" data-value="Nice" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Nice</button>
                    <button type="button" class="suggestion-btn" data-target="geography" data-value="Lyon" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">Lyon</button>
                  </div>
                </div>

                <!-- Contract types -->
                <div>
                  <fieldset style="border:none;padding:0;margin:0;">
                    <legend class="jb-label" data-i18n="profile.contract.legend">Contract types</legend>
                    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:0.5rem;">
                      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
                        <input type="checkbox" id="ct-cdi" data-contract="CDI" class="contract-cb" style="accent-color:var(--jb-primary);width:1rem;height:1rem;" />
                        CDI
                      </label>
                      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
                        <input type="checkbox" id="ct-freelance" data-contract="Freelance" class="contract-cb" style="accent-color:var(--jb-primary);width:1rem;height:1rem;" />
                        Freelance
                      </label>
                      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
                        <input type="checkbox" id="ct-mission" data-contract="Mission" class="contract-cb" style="accent-color:var(--jb-primary);width:1rem;height:1rem;" />
                        Mission
                      </label>
                      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;">
                        <input type="checkbox" id="ct-cdd" data-contract="CDD" class="contract-cb" style="accent-color:var(--jb-primary);width:1rem;height:1rem;" />
                        CDD
                      </label>
                    </div>
                  </fieldset>
                </div>

                <!-- Seniority -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                  <div>
                    <label class="jb-label" for="seniority-select" data-i18n="profile.seniority.label">Seniority</label>
                    <select id="seniority-select" class="jb-input" style="cursor:pointer;">
                      <option value="Junior">Junior</option>
                      <option value="Mid">Mid</option>
                      <option value="Senior" selected>Senior</option>
                      <option value="Staff">Staff</option>
                      <option value="Principal">Principal</option>
                    </select>
                  </div>
                  <div>
                    <label class="jb-label" for="years-exp" data-i18n="profile.years.label">Years of exp. (optional)</label>
                    <input class="jb-input" id="years-exp" type="number" min="0" max="40" data-i18n-placeholder="profile.years.placeholder" placeholder="E.g. 8" />
                  </div>
                </div>

                <!-- Salary / TJM -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                  <div>
                    <label class="jb-label" for="min-salary" data-i18n="profile.salary.label">Min CDI salary (€/year, optional)</label>
                    <input class="jb-input" id="min-salary" type="number" min="0" step="1000" data-i18n-placeholder="profile.salary.placeholder" placeholder="E.g. 65000" />
                  </div>
                  <div>
                    <label class="jb-label" for="min-tjm" data-i18n="profile.tjm.label">Min daily rate (€/day, optional)</label>
                    <input class="jb-input" id="min-tjm" type="number" min="0" step="50" data-i18n-placeholder="profile.tjm.placeholder" placeholder="E.g. 600" />
                  </div>
                </div>

              </div>

              <div style="display:flex;justify-content:flex-end;margin-top:2rem;">
                <button type="button" class="jb-btn-primary next-step" data-next="1" data-i18n="btn.next.search">
                  Next: Search
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- === STEP 2: Search === -->
            <div class="wizard-step" data-step="1" style="display:none;">
              <h3 style="font-size:1.125rem;font-weight:700;color:var(--jb-text);margin-bottom:1.5rem;" data-i18n="search.heading">Search parameters</h3>

              <div style="display:grid;gap:1.5rem;">

                <!-- Search modes -->
                <div>
                  <fieldset style="border:none;padding:0;margin:0;">
                    <legend class="jb-label" data-i18n="search.modes.legend">Search modes</legend>
                    <div style="display:grid;gap:0.625rem;margin-top:0.5rem;">
                      <label style="display:flex;align-items:flex-start;gap:0.75rem;cursor:pointer;padding:0.75rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);">
                        <input type="checkbox" id="mode-platform" data-mode="PLATFORM" class="mode-cb" checked style="accent-color:var(--jb-primary);width:1rem;height:1rem;margin-top:0.125rem;flex-shrink:0;" />
                        <div>
                          <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">PLATFORM</div>
                          <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="search.mode.platform.desc">Targeted search on job platforms (WelcomeToTheJungle, Free-Work, Malt…)</div>
                        </div>
                      </label>
                      <label style="display:flex;align-items:flex-start;gap:0.75rem;cursor:pointer;padding:0.75rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);">
                        <input type="checkbox" id="mode-careers" data-mode="CAREERS" class="mode-cb" checked style="accent-color:var(--jb-primary);width:1rem;height:1rem;margin-top:0.125rem;flex-shrink:0;" />
                        <div>
                          <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">CAREERS</div>
                          <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="search.mode.careers.desc">Company career pages directly (Node.js hiring Nice)</div>
                        </div>
                      </label>
                      <label style="display:flex;align-items:flex-start;gap:0.75rem;cursor:pointer;padding:0.75rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);">
                        <input type="checkbox" id="mode-linkedin" data-mode="LINKEDIN" class="mode-cb" style="accent-color:var(--jb-primary);width:1rem;height:1rem;margin-top:0.125rem;flex-shrink:0;" />
                        <div>
                          <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">LINKEDIN</div>
                          <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="search.mode.linkedin.desc">Search on LinkedIn Jobs (may be blocked depending on ToS)</div>
                        </div>
                      </label>
                    </div>
                  </fieldset>
                </div>

                <!-- Platforms -->
                <div>
                  <label class="jb-label" for="platforms-input" data-i18n="search.platforms.label">Target platforms</label>
                  <div id="platforms-tags" style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-bottom:0.5rem;" aria-live="polite"></div>
                  <div style="display:flex;gap:0.5rem;">
                    <input class="jb-input" id="platforms-input" type="text" data-i18n-placeholder="search.platforms.placeholder" placeholder="E.g. talent.io" style="flex:1;" />
                    <button type="button" id="platforms-add" class="jb-btn-secondary" style="white-space:nowrap;padding:0.5rem 0.875rem;border-radius:var(--jb-radius-input);" data-i18n="btn.add">+ Add</button>
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-top:0.5rem;" aria-hidden="true">
                    <button type="button" class="suggestion-btn" data-target="platforms" data-value="welcometothejungle.com" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">welcometothejungle.com</button>
                    <button type="button" class="suggestion-btn" data-target="platforms" data-value="free-work.com" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">free-work.com</button>
                    <button type="button" class="suggestion-btn" data-target="platforms" data-value="malt.fr" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">malt.fr</button>
                    <button type="button" class="suggestion-btn" data-target="platforms" data-value="talent.io" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">talent.io</button>
                    <button type="button" class="suggestion-btn" data-target="platforms" data-value="lesjeudis.com" style="font-size:0.6875rem;padding:0.15rem 0.5rem;border:1px solid var(--jb-border);border-radius:999px;background:var(--jb-surface-alt);color:var(--jb-text-muted);cursor:pointer;">lesjeudis.com</button>
                  </div>
                </div>

                <!-- Score threshold -->
                <div>
                  <label class="jb-label" for="score-threshold"><span data-i18n="search.threshold.label">Minimum score (0–100):</span> <strong id="threshold-display">50</strong></label>
                  <input type="range" id="score-threshold" min="0" max="100" value="50" step="5"
                    style="width:100%;accent-color:var(--jb-primary);cursor:pointer;"
                    aria-describedby="threshold-hint"
                  />
                  <div id="threshold-hint" style="display:flex;justify-content:space-between;font-size:0.6875rem;color:var(--jb-text-muted);margin-top:0.25rem;">
                    <span data-i18n="search.threshold.low">0 — see all</span>
                    <span data-i18n="search.threshold.mid">50 — recommended</span>
                    <span data-i18n="search.threshold.high">100 — exact</span>
                  </div>
                </div>

              </div>

              <div style="display:flex;justify-content:space-between;margin-top:2rem;">
                <button type="button" class="jb-btn-secondary prev-step" data-prev="0" data-i18n="btn.back">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                  Back
                </button>
                <button type="button" class="jb-btn-primary next-step" data-next="2" data-i18n="btn.next.llm">
                  Next: LLM
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- === STEP 3: LLM === -->
            <div class="wizard-step" data-step="2" style="display:none;">
              <h3 style="font-size:1.125rem;font-weight:700;color:var(--jb-text);margin-bottom:0.5rem;" data-i18n="llm.heading">Language model (LLM)</h3>
              <p style="font-size:0.8125rem;color:var(--jb-text-muted);margin-bottom:1.5rem;" data-i18n="llm.subtitle">The agent uses this LLM locally to understand and score job listings.</p>

              <!-- Privacy badge in LLM step -->
              <div style="display:flex;align-items:flex-start;gap:0.75rem;padding:0.875rem 1rem;background:var(--jb-accent-bg);border:1px solid var(--jb-accent);border-radius:var(--jb-radius-input);margin-bottom:1.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--jb-accent-text)" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;margin-top:0.125rem;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <div>
                  <p style="font-size:0.8125rem;font-weight:600;color:var(--jb-accent-text);margin:0 0 0.25rem;" data-i18n="llm.key.title">Your API key is configured locally — never here.</p>
                  <p style="font-size:0.75rem;color:var(--jb-accent-text);margin:0;" data-i18n="llm.key.desc">Use the environment variable <code style="font-family:monospace;background:var(--jb-accent-bg);padding:0.05em 0.3em;border-radius:3px;">JOBHUNT_LLM_API_KEY</code> or the system keychain. Your key never passes through our servers.</p>
                </div>
              </div>

              <div style="display:grid;gap:1.25rem;">

                <!-- Provider cards -->
                <div>
                  <fieldset style="border:none;padding:0;margin:0;">
                    <legend class="jb-label" data-i18n="llm.provider.legend">LLM Provider</legend>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:0.625rem;margin-top:0.5rem;">

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="ollama" checked class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card active" data-provider="ollama" style="padding:0.875rem;border:2px solid var(--jb-primary);border-radius:var(--jb-radius-input);background:var(--jb-primary-soft);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-primary);margin-bottom:0.25rem;">Ollama</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);" data-i18n="llm.ollama.desc">Recommended — 100% local</div>
                          <div style="margin-top:0.375rem;font-size:0.625rem;background:var(--jb-primary);color:white;border-radius:999px;padding:0.1em 0.5em;display:inline-block;" data-i18n="llm.nokey">No key</div>
                        </div>
                      </label>

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="lmstudio" class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card" data-provider="lmstudio" style="padding:0.875rem;border:2px solid var(--jb-border);border-radius:var(--jb-radius-input);background:var(--jb-surface);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-text);margin-bottom:0.25rem;">LM Studio</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);" data-i18n="llm.lmstudio.desc">Local, graphical UI</div>
                        </div>
                      </label>

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="openai" class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card" data-provider="openai" style="padding:0.875rem;border:2px solid var(--jb-border);border-radius:var(--jb-radius-input);background:var(--jb-surface);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-text);margin-bottom:0.25rem;">OpenAI</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);">GPT-4o / GPT-4 mini</div>
                        </div>
                      </label>

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="anthropic" class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card" data-provider="anthropic" style="padding:0.875rem;border:2px solid var(--jb-border);border-radius:var(--jb-radius-input);background:var(--jb-surface);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-text);margin-bottom:0.25rem;">Anthropic</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);">Claude Haiku / Sonnet</div>
                        </div>
                      </label>

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="mistral" class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card" data-provider="mistral" style="padding:0.875rem;border:2px solid var(--jb-border);border-radius:var(--jb-radius-input);background:var(--jb-surface);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-text);margin-bottom:0.25rem;">Mistral</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);">Mistral 7B / Small</div>
                        </div>
                      </label>

                      <label class="llm-card-label" style="cursor:pointer;">
                        <input type="radio" name="llm-provider" value="groq" class="llm-provider-radio" style="position:absolute;opacity:0;pointer-events:none;" />
                        <div class="llm-card" data-provider="groq" style="padding:0.875rem;border:2px solid var(--jb-border);border-radius:var(--jb-radius-input);background:var(--jb-surface);">
                          <div style="font-weight:700;font-size:0.875rem;color:var(--jb-text);margin-bottom:0.25rem;">Groq</div>
                          <div style="font-size:0.6875rem;color:var(--jb-text-muted);" data-i18n="llm.groq.desc">Very fast, free tier</div>
                        </div>
                      </label>

                    </div>
                  </fieldset>
                </div>

                <!-- Model name -->
                <div>
                  <label class="jb-label" for="llm-model" data-i18n="llm.model.label">Model name</label>
                  <input class="jb-input" id="llm-model" type="text" value="gemma4:e2b" placeholder="gemma4:e2b" />
                  <p id="llm-model-hint" style="font-size:0.75rem;color:var(--jb-text-muted);margin-top:0.375rem;" data-i18n="llm.model.hint">For Ollama: <code style="font-family:monospace;background:var(--jb-surface-alt);padding:0.05em 0.3em;border-radius:3px;">gemma4:e2b</code> (lightweight), <code style="font-family:monospace;background:var(--jb-surface-alt);padding:0.05em 0.3em;border-radius:3px;">gemma4:e4b</code>, <code style="font-family:monospace;background:var(--jb-surface-alt);padding:0.05em 0.3em;border-radius:3px;">qwen2.5:7b</code></p>
                </div>

                <!-- Base URL (advanced) -->
                <details style="border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);overflow:hidden;">
                  <summary style="padding:0.75rem;cursor:pointer;font-size:0.8125rem;font-weight:600;color:var(--jb-text);list-style:none;display:flex;align-items:center;justify-content:space-between;" data-i18n="llm.advanced.summary">
                    Advanced settings (base URL)
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </summary>
                  <div style="padding:0.75rem;border-top:1px solid var(--jb-border);">
                    <label class="jb-label" for="llm-base-url" data-i18n="llm.baseurl.label">LLM base URL</label>
                    <input class="jb-input" id="llm-base-url" type="url" value="http://localhost:11434" placeholder="http://localhost:11434" />
                    <p style="font-size:0.75rem;color:var(--jb-text-muted);margin-top:0.375rem;" data-i18n="llm.baseurl.hint">Ollama local: http://localhost:11434 · LM Studio: http://localhost:1234</p>
                  </div>
                </details>

              </div>

              <div style="display:flex;justify-content:space-between;margin-top:2rem;">
                <button type="button" class="jb-btn-secondary prev-step" data-prev="1" data-i18n="btn.back">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                  Back
                </button>
                <button type="button" class="jb-btn-primary next-step" data-next="3" data-i18n="btn.next.sources">
                  Next: Sources
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            </div>

            <!-- === STEP 4: Sources === -->
            <div class="wizard-step" data-step="3" style="display:none;">
              <h3 style="font-size:1.125rem;font-weight:700;color:var(--jb-text);margin-bottom:1.5rem;" data-i18n="sources.heading">Sources to enable</h3>

              <div style="display:grid;gap:0.875rem;">

                <label style="display:flex;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);cursor:pointer;gap:1rem;">
                  <div>
                    <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">France Travail</div>
                    <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="sources.ft.desc">Pôle Emploi — public listings, broad CDI coverage</div>
                  </div>
                  <input type="checkbox" id="src-france-travail" class="jb-toggle" checked data-i18n-aria="sources.ft.aria" aria-label="Enable France Travail" />
                </label>

                <label style="display:flex;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);cursor:pointer;gap:1rem;">
                  <div>
                    <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);" data-i18n="sources.rss.title">RSS job feeds</div>
                    <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="sources.rss.desc">Official &amp; stable, often with full text — no scraping. Configurable feeds in the local dashboard.</div>
                  </div>
                  <input type="checkbox" id="src-rss" class="jb-toggle" checked data-i18n-aria="sources.rss.aria" aria-label="Enable RSS feeds" />
                </label>

                <label style="display:flex;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);cursor:pointer;gap:1rem;">
                  <div>
                    <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">Welcome to the Jungle</div>
                    <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="sources.wttj.desc">Startups &amp; scale-ups — great for tech profiles</div>
                  </div>
                  <input type="checkbox" id="src-wttj" class="jb-toggle" checked data-i18n-aria="sources.wttj.aria" aria-label="Enable Welcome to the Jungle" />
                </label>

                <label style="display:flex;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--jb-border);border-radius:var(--jb-radius-input);cursor:pointer;gap:1rem;">
                  <div>
                    <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">Indeed</div>
                    <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="sources.indeed.desc">General aggregator, high volume</div>
                  </div>
                  <input type="checkbox" id="src-indeed" class="jb-toggle" data-i18n-aria="sources.indeed.aria" aria-label="Enable Indeed" />
                </label>

                <!-- LinkedIn - with disclaimer -->
                <div style="border:1px solid var(--jb-signal);border-radius:var(--jb-radius-input);overflow:hidden;">
                  <label style="display:flex;align-items:center;justify-content:space-between;padding:1rem;cursor:pointer;gap:1rem;background:color-mix(in srgb, var(--jb-signal) 10%, var(--jb-surface));">
                    <div>
                      <div style="font-weight:600;font-size:0.875rem;color:var(--jb-text);">LinkedIn Jobs</div>
                      <div style="font-size:0.75rem;color:var(--jb-text-muted);" data-i18n="sources.linkedin.desc">Professional network — scraping may be blocked</div>
                    </div>
                    <input type="checkbox" id="src-linkedin" class="jb-toggle" data-i18n-aria="sources.linkedin.aria" aria-label="Enable LinkedIn (ToS risk)" />
